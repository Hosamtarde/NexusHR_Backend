PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=hrms_user
DB_PASSWORD=hrms_pass
DB_NAME=hrms_db

JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d

# Rocket.Chat password sync: the Rocket.Chat password of every user is kept equal to
# the NexusHR password (set on employee creation, login, password change and the HR
# reset). The Rocket.Chat server must accept those passwords. In Administration >
# Settings > Accounts > Password Policy:
#   - allow passwords of at least 6 characters on account creation (employee passwords
#     are validated with min 6 on creation and min 8 on change)
#   - keep "Enable Password Policy" off, or set its minimum length to 6 or less
#   - optional: Accounts > "Allow Password Change" off, so users change the password
#     only through NexusHR and the two never drift apart
ROCKETCHAT_URL=http://localhost:3100
ROCKETCHAT_BOT_USER_ID=your-bot-user-id
ROCKETCHAT_BOT_TOKEN=your-bot-personal-access-token
# Optional: lets POST /auth/refresh return a renewed chat token without the password.
# Must equal CREATE_TOKENS_FOR_USERS_SECRET set on the Rocket.Chat server; when empty,
# refresh returns chat: null and the client keeps its current chat token.
ROCKETCHAT_TOKEN_SECRET=
JITSI_BASE_URL=https://meet.jit.si
APP_FRONTEND_URL=http://localhost:5173